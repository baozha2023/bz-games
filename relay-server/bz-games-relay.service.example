[Unit]
Description=BZ-Games Relay Server
After=network.target

[Service]
WorkingDirectory=/opt/bz-games-relay
ExecStart=/usr/bin/node src/index.js
Environment=PORT=38091
Environment=HOST=127.0.0.1
Environment=ROOM_TTL_MS=60000
Environment=HEARTBEAT_INTERVAL_MS=30000
Environment=MAX_TEXT_BYTES=1048576
Environment=MAX_BINARY_BYTES=12582912
Environment=MAX_PLATFORM_CLOUD_SNAPSHOT_BYTES=134217728
Environment=CLOUD_V2_MAINTENANCE=false
Environment=PLATFORM_SNAPSHOT_GC_GRACE_MS=300000
Environment=MAX_FEEDBACK_REQUEST_BYTES=25165824
Environment=MAX_FEEDBACK_TEXT_LENGTH=5000
Environment=MAX_FEEDBACK_IMAGES=4
Environment=MAX_FEEDBACK_IMAGE_BYTES=5242880
Environment=GAME_HOSTING_STORAGE_DIR=/var/lib/bz-games-hosting
Environment=MAX_GAME_HOSTING_FILE_BYTES=209715200
Environment=MAX_GAME_HOSTING_IMAGE_BYTES=5242880
Environment=MAX_GAME_HOSTING_TOTAL_BYTES=5368709120
Environment=DESKTOP_RELEASE_STORAGE_DIR=/var/lib/bz-games-releases
Environment=MAX_DESKTOP_RELEASE_FILE_BYTES=536870912
Environment=DESKTOP_RELEASE_BANDWIDTH_BPS=100000000
Environment=FEEDBACK_AUTHENTICATED_COOLDOWN_MS=43200000
Environment=RATE_LIMIT_RESERVATION_TTL_MS=300000
Environment=MAX_FORUM_REQUEST_BYTES=25165824
Environment=MAX_FORUM_TITLE_LENGTH=80
Environment=MAX_FORUM_BODY_LENGTH=5000
Environment=MAX_FORUM_COMMENT_LENGTH=1000
Environment=MAX_FORUM_IMAGES=4
Environment=MAX_FORUM_IMAGE_BYTES=5242880
Environment=FORUM_PLAYER_POST_COOLDOWN_MS=86400000
Environment=FORUM_ADMIN_POST_COOLDOWN_MS=3600000
Environment=FORUM_PLAYER_COMMENT_COOLDOWN_MS=1800000
Environment=FORUM_ADMIN_COMMENT_COOLDOWN_MS=300000
Environment=ELASTICSEARCH_ENABLED=false
Environment=ELASTICSEARCH_URL=
Environment=ELASTICSEARCH_USERNAME=relay_forum
Environment=ELASTICSEARCH_PASSWORD=YOUR_ELASTICSEARCH_PASSWORD
Environment=ELASTICSEARCH_INDEX_ALIAS=bz_forum_posts
Environment=ELASTICSEARCH_REQUEST_TIMEOUT_MS=5000
Environment=FORUM_SEARCH_WORKER_INTERVAL_MS=5000
Environment=PORTAL_PUBLIC_URL=https://relay.example.com/admin/
Environment=ADMIN_STATIC_DIR=/var/www/campusmate/admin
Environment=RELAY_TOKEN=YOUR_RELAY_TOKEN
Environment=MAX_ROOMS=80
Environment=MAX_CLIENTS=400
Environment=MAX_CLIENTS_PER_ROOM=10
Environment=MAX_EVENT_LOOP_DELAY_MS=250
Environment=MONGODB_URI=YOUR_MONGODB_URI
Environment=MONGODB_DB_NAME=bz_games
Environment=MONGODB_BUCKET_NAME=userFiles
Environment=MYSQL_HOST=127.0.0.1
Environment=MYSQL_PORT=3306
Environment=MYSQL_USER=YOUR_MYSQL_USER
Environment=MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
Environment=MYSQL_DATABASE=bz_games
Environment=GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
Environment=GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
Environment=GITHUB_CALLBACK_URL=https://relay.example.com/auth/github/callback
Environment="GITHUB_OAUTH_SCOPE=read:user user:email"
Environment=SESSION_COOKIE_NAME=bz_games_session
Environment=OAUTH_SESSION_TTL_MS=2592000000
Environment=AUTH_EXPIRED_SESSION_RETENTION_MS=604800000
Environment=OAUTH_STATE_TTL_MS=600000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
